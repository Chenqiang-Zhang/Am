# ================================================================
# .env.example — セットアップ手順
#
# 1. このファイルを .env にコピーする
#      cp .env.example .env        # Mac/Linux
#      copy .env.example .env      # Windows
#
# 2. .env を開いて = の右側に実際の値を入力する
#
# .env は .gitignore に含まれているのでコミットされない。
# このファイル（.env.example）は値を書かずにコミットしてよい。
# ================================================================


# ================================================================
# 【必須】Neo4j Aura 接続情報
# ================================================================
# 取得方法:
#   1. https://console.neo4j.io にアクセス
#   2. インスタンスのカードを開く
#   3. "Connection URI" をコピー → NEO4J_URI に貼り付け
#   4. パスワードはインスタンス作成時に表示される（忘れた場合は Reset Password）
#
# ユーザー名は Aura では常に "neo4j" なので変更不要。

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_PASSWORD=


# ================================================================
# 【必須】LLM API キー（いずれか1つ）
# ================================================================

# 実行環境別の LLM 接続先（任意）。指定した値は config.yaml より優先される。
# Kubera の vLLM / ローカル LM Studio の例:
# LLM_PROVIDER=deepseek
# LLM_MODEL=qwen/qwen3.5-9b
# LLM_BASE_URL=http://localhost:1234/v1
#
# GPU サーバーを使う場合は LLM_BASE_URL だけをサーバーの OpenAI 互換 /v1
# エンドポイントに変更する。APIキーが不要なローカルサーバーでも、DeepSeek互換として
# 接続する場合は DEEPSEEK_API_KEY に任意の非空文字列を設定する。
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=

# ---- Gemini（無料・推奨） ----
# 取得: https://aistudio.google.com/apikey
#       Google アカウントでログイン → "Create API key" をクリック
GEMINI_API_KEY=

# ---- Groq（無料・高速。Gemini の代わりに使う場合） ----
# 取得: https://console.groq.com → "API Keys" → "Create API Key"
# 使い方: config.yaml の llm.provider を "groq" に変更する
# GROQ_API_KEY=

# ---- DeepSeek（低コスト有料） ----
# 使い方: config.yaml の llm.provider を "deepseek" に変更する
# DEEPSEEK_API_KEY=

# ---- OpenAI（有料） ----
# 使い方: config.yaml の llm.provider を "openai" に変更する
# OPENAI_API_KEY=
